{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the widget, settings and grid windows",
  "windows": [
    "widget",
    "settings",
    "grid",
    "menu"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
