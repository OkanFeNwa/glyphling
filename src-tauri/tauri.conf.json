{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphling",
  "version": "0.9.1",
  "identifier": "com.okanfenwa.glyphling",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "OkanFeNwa",
    "category": "Utility",
    "shortDescription": "Widget desktop in stile Nothing OS",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Italian"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  }
}
